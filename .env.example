# Copy to .env.local for local configuration.
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/bizai?schema=public
AUTH_SECRET=replace-with-a-long-random-secret

# Mock AI is enabled unless explicitly set to false.
USE_MOCK_AI=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional free Telegram florist bot. Register its webhook after deployment.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Billing is not connected in this preview.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional auth provider configuration for a future server-backed rollout.
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
