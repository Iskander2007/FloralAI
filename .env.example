# Copy to .env.local for local configuration.
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/bizai?schema=public
AUTH_SECRET=replace-with-a-long-random-secret

# Mock AI is enabled unless explicitly set to false.
USE_MOCK_AI=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional free Telegram florist bot. Register its webhook after deployment.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp Business Platform / Embedded Signup (one Meta app, each owner authorizes their own number).
# Set enabled only after configuring Meta webhooks, permissions and login configuration.
WHATSAPP_ENABLED=false
META_APP_ID=
META_APP_SECRET=
META_WHATSAPP_CONFIG_ID=
# Use the supported Graph version selected in your Meta App Dashboard, including the v prefix.
META_GRAPH_VERSION=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# 32 random bytes as 64 hex characters. Server-only; keep across deployments.
WHATSAPP_TOKEN_ENCRYPTION_KEY=
# Enable only when Meta has enabled WhatsApp Business App coexistence for your app.
WHATSAPP_COEXISTENCE_ENABLED=false
# Optional: secret for a scheduler to POST /api/whatsapp/retry after a crashed webhook.
WHATSAPP_RETRY_SECRET=

# Subscription payments use manually issued Kaspi invoices and Supabase.
# No bank API key is used. Operator UUIDs are granted in billing_operators.

# Optional Supabase Auth. Add the public URL and publishable key to enable email
# confirmation and Google OAuth. Never expose a service-role key to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon-key fallback, if your Supabase project has not issued publishable keys.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
